<!-- Botón Try-On -->
<button id="clostech-tryon-btn" style="background:#000; color:#fff; padding:15px 30px; border:none; cursor:pointer; text-transform:uppercase; font-weight:600;">
    Probador Virtual
</button>

<!-- Modal con Iframe -->
<div id="clostech-modal" style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.9); z-index:9999;">
    <button onclick="document.getElementById('clostech-modal').style.display='none'" style="position:absolute; top:20px; right:20px; background:#fff; border:none; width:40px; height:40px; cursor:pointer; font-size:24px;">×</button>
    <iframe src="/clostech/tryon" style="width:100%; height:100%; border:none;"></iframe>
</div>

<script>
document.getElementById('clostech-tryon-btn').addEventListener('click', function() {
    document.getElementById('clostech-modal').style.display = 'block';
});
</script>