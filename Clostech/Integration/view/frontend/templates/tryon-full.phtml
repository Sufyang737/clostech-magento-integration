<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Clostech Virtual Fitting Room</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100;300;400;500;600;700&display=swap"
        rel="stylesheet" />

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- React & ReactDOM -->
    <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>

    <!-- Babel para procesar React (JSX) en el navegador -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            overscroll-behavior-y: none;
        }

        @keyframes scanMove {
            0% { top: 0%; opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { top: 100%; opacity: 0; }
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .animate-scan { animation: scanMove 2.5s ease-in-out infinite; }
        .animate-fade-in { animation: fadeIn 0.6s ease forwards; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        /* Hide number input spinners */
        input[type=number]::-webkit-inner-spin-button,
        input[type=number]::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        input[type=number] {
            -moz-appearance: textfield;
        }

        /* Dynamic primary button using CSS variables from storeStyles */
        .vm-btn-primary-react {
            background: var(--btn-bg, #2196F3);
            color: var(--btn-text, #fff);
            border: 1px solid var(--btn-bg, #2196F3);
            cursor: pointer;
        }
        .vm-btn-primary-react:not(:disabled):hover {
            background: var(--btn-hover-bg, #1976D2);
            border-color: var(--btn-hover-bg, #1976D2);
            color: var(--btn-hover-text, #fff);
        }

        /* Mobile modal adjustments */
        @media (max-width: 768px) {
            .vm-mobile-img {
                display: block !important;
                width: 100%;
                height: auto;
                max-height: 350px;
                object-fit: contain;
                margin: 0 auto 20px auto;
                border-radius: 8px;
                background: #f8fafc;
            }
        }
    </style>
</head>

<body class="bg-white/95 text-[#111111] antialiased h-[100dvh] w-full overflow-hidden flex items-center justify-center p-5 md:p-5" style="backdrop-filter: blur(10px);">

    <!-- React Root -->
    <div id="root" class="w-full h-full flex items-center justify-center"></div>

    <!-- Application Logic -->
    <script type="text/babel">
        const { useState, useEffect, useRef } = React;
        const { createRoot } = ReactDOM;

        // Inject dynamic button colors as CSS variables
        (() => {
            const params = new URLSearchParams(window.location.search);
            const root = document.documentElement;
            root.style.setProperty('--btn-bg', params.get('btn_bg') || '#2196F3');
            root.style.setProperty('--btn-text', params.get('btn_text') || '#fff');
            root.style.setProperty('--btn-hover-bg', params.get('btn_hover_bg') || '#1976D2');
            root.style.setProperty('--btn-hover-text', params.get('btn_hover_text') || '#fff');
        })();

        // =====================================================================
        // ICONS - Inline SVGs (no external CDN dependency)
        // Matching Phosphor Light style from main.js
        // =====================================================================
        const SunIcon = ({ size = 24 }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 256 256" fill="none" stroke="currentColor" strokeWidth="12" strokeLinecap="round" strokeLinejoin="round">
                <circle cx="128" cy="128" r="60" />
                <line x1="128" y1="36" x2="128" y2="16" />
                <line x1="63" y1="63" x2="49" y2="49" />
                <line x1="36" y1="128" x2="16" y2="128" />
                <line x1="63" y1="193" x2="49" y2="207" />
                <line x1="128" y1="220" x2="128" y2="240" />
                <line x1="193" y1="193" x2="207" y2="207" />
                <line x1="220" y1="128" x2="240" y2="128" />
                <line x1="193" y1="63" x2="207" y2="49" />
            </svg>
        );

        const PersonSimpleIcon = ({ size = 24 }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 256 256" fill="none" stroke="currentColor" strokeWidth="12" strokeLinecap="round" strokeLinejoin="round">
                <circle cx="128" cy="36" r="24" />
                <line x1="128" y1="60" x2="128" y2="168" />
                <line x1="128" y1="168" x2="80" y2="240" />
                <line x1="128" y1="168" x2="176" y2="240" />
                <line x1="56" y1="120" x2="200" y2="120" />
            </svg>
        );

        const XIcon = ({ size = 24 }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 256 256" fill="none" stroke="currentColor" strokeWidth="12" strokeLinecap="round" strokeLinejoin="round">
                <line x1="200" y1="56" x2="56" y2="200" />
                <line x1="200" y1="200" x2="56" y2="56" />
            </svg>
        );

        const CheckCircleIcon = ({ size = 24 }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 256 256" fill="none" stroke="currentColor" strokeWidth="12" strokeLinecap="round" strokeLinejoin="round">
                <circle cx="128" cy="128" r="96" />
                <polyline points="88 136 112 160 168 104" />
            </svg>
        );

        const UploadIcon = ({ size = 24 }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 256 256" fill="none" stroke="currentColor" strokeWidth="12" strokeLinecap="round" strokeLinejoin="round">
                <polyline points="86 82 128 40 170 82" />
                <line x1="128" y1="40" x2="128" y2="176" />
                <path d="M216,152v56a8,8,0,0,1-8,8H48a8,8,0,0,1-8-8V152" />
            </svg>
        );

        const ShoppingBagIcon = ({ size = 24 }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 256 256" fill="none" stroke="currentColor" strokeWidth="12" strokeLinecap="round" strokeLinejoin="round">
                <rect x="32" y="72" width="192" height="152" rx="8" />
                <path d="M88,72V64a40,40,0,0,1,80,0v8" />
            </svg>
        );

        const WhatsAppIcon = ({ size = 24 }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 256 256" fill="none" stroke="currentColor" strokeWidth="12" strokeLinecap="round" strokeLinejoin="round">
                <path d="M128,28A100,100,0,0,0,45.1,190.2L36,224l33.8-9.1A100,100,0,1,0,128,28Z" />
                <path d="M100,120a28,28,0,0,0,28,28h0a28,28,0,0,0,28-28v-8a28,28,0,0,0-28-28h0a28,28,0,0,0-28,28Z" />
            </svg>
        );

        const DownloadIcon = ({ size = 24 }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 256 256" fill="none" stroke="currentColor" strokeWidth="12" strokeLinecap="round" strokeLinejoin="round">
                <polyline points="86 174 128 216 170 174" />
                <line x1="128" y1="216" x2="128" y2="80" />
                <path d="M216,152v56a8,8,0,0,1-8,8H48a8,8,0,0,1-8-8V152" />
            </svg>
        );

        const AlertCircleIcon = ({ size = 24 }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 256 256" fill="none" stroke="currentColor" strokeWidth="12" strokeLinecap="round" strokeLinejoin="round">
                <circle cx="128" cy="128" r="96" />
                <line x1="128" y1="80" x2="128" y2="136" />
                <circle cx="128" cy="172" r="8" fill="currentColor" stroke="none" />
            </svg>
        );

        // Business Logo component (replaces eyebrow indicators)
        const BusinessLogo = () => CONFIG.businessLogo ? (
            <img src={CONFIG.businessLogo} alt="Logo" style={{ height: '40px', objectFit: 'contain', marginBottom: '16px' }} />
        ) : null;

        // Gender SVG icons (matching Phosphor icons from main.js)
        const GenderFemaleIcon = ({ size = 40 }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 256 256" fill="none" stroke="currentColor" strokeWidth="12" strokeLinecap="round" strokeLinejoin="round">
                <circle cx="128" cy="96" r="72" />
                <line x1="128" y1="168" x2="128" y2="240" />
                <line x1="96" y1="208" x2="160" y2="208" />
            </svg>
        );
        const GenderMaleIcon = ({ size = 40 }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 256 256" fill="none" stroke="currentColor" strokeWidth="12" strokeLinecap="round" strokeLinejoin="round">
                <circle cx="112" cy="144" r="72" />
                <line x1="168" y1="88" x2="224" y2="32" />
                <polyline points="176 32 224 32 224 80" />
            </svg>
        );
        // =====================================================================
        // CONFIG - Leer parámetros de URL
        // =====================================================================
        const getUrlParams = () => {
            const params = new URLSearchParams(window.location.search);
            return {
                productId: params.get('product_id') || null,
                productSku: params.get('product_sku') || null,
                productName: params.get('product_name') || null,
                productImage: params.get('product_image') || null,
                storeId: params.get('store_id') || null,
                apiKey: params.get('api_key') || null,
                clientId: params.get('client_id') || null,
                configurations: JSON.parse(params.get('configurations') || '{}'),
                options: JSON.parse(params.get('options') || '{"sizes":[],"colors":[]}'),
                variantImages: JSON.parse(params.get('variant_images') || '{}'),
                businessLogo: params.get('business_logo') || null,
                btnBg: params.get('btn_bg') || '#2196F3',
                btnText: params.get('btn_text') || '#fff',
                btnHoverBg: params.get('btn_hover_bg') || '#1976D2',
                btnHoverText: params.get('btn_hover_text') || '#fff',
            };
        };

        const CONFIG = getUrlParams();
        // Trim whitespace from API credentials (Magento sometimes adds leading spaces)
        if (CONFIG.storeId) CONFIG.storeId = CONFIG.storeId.trim();
        if (CONFIG.apiKey) CONFIG.apiKey = CONFIG.apiKey.trim();
        if (CONFIG.clientId) CONFIG.clientId = CONFIG.clientId.trim();
        const CLOSTECH_API_URL = 'https://portal-empresa.clostech.tech';

        // =====================================================================
        // API FUNCTIONS
        // =====================================================================
        const uploadUserPhoto = async (file) => {
            const formData = new FormData();
            formData.append('file', file);

            const response = await fetch(`${CLOSTECH_API_URL}/api/upload-image`, {
                method: 'POST',
                body: formData,
            });

            if (!response.ok) throw new Error('Error al subir la imagen');
            
            const data = await response.json();
            if (!data.url) throw new Error('No se recibió URL de imagen');
            
            return data.url;
        };

        const processWithAI = async (userImageUrl, { variantId = null, variantValues = null, clothImageUrl = null } = {}) => {
            const response = await fetch(`${CLOSTECH_API_URL}/api/ai-v2`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    api_key: CONFIG.apiKey,
                    store_id: CONFIG.storeId,
                    client_id: CONFIG.clientId,
                    product_id: CONFIG.productId,
                    variant_id: variantId,
                    variant_values: variantValues,
                    user_image_url: userImageUrl,
                    cloth_image_url: clothImageUrl || CONFIG.productImage,
                }),
            });

            if (!response.ok) throw new Error('Error en el procesamiento de IA');
            
            const apiResponse = await response.json();
            
            if (!apiResponse.success || !apiResponse.data?.generated_image_url) {
                throw new Error('No se recibió resultado de IA');
            }
            
            return {
                result_image_url: apiResponse.data.generated_image_url,
                recommended_size: 'L'
            };
        };

        const saveUsageToLocalStorage = (resultImageUrl) => {
            const tryOnData = {
                productId: CONFIG.productId,
                productName: CONFIG.productName,
                productSku: CONFIG.productSku,
                timestamp: Date.now(),
                imageUrl: resultImageUrl,
                used: true
            };
            localStorage.setItem(`clostech_tryon_${CONFIG.productId}`, JSON.stringify(tryOnData));
            localStorage.setItem('use_clostech', 'true');
        };

        // Obtener form_key de Magento para CSRF protection
        const getFormKey = () => {
            const formKeyInput = window.parent.document.querySelector('input[name="form_key"]');
            return formKeyInput ? formKeyInput.value : null;
        };

        // Agregar producto al carrito
        const addToCart = async (productId, size, color) => {
            let finalProductId = productId;
            
            if (size && color && Object.keys(CONFIG.configurations).length > 0) {
                const key = `${size}-${color}`;
                const childId = CONFIG.configurations[key];
                
                if (childId) {
                    finalProductId = childId;
                    console.log(`Producto configurable: usando hijo ${childId} para ${key}`);
                } else {
                    console.warn(`No se encontró producto hijo para ${key}`, CONFIG.configurations);
                    throw new Error(`No hay stock disponible para ${size}-${color}`);
                }
            } else {
                console.log(`Producto simple: agregando directamente ${productId}`);
            }
            
            const formKey = getFormKey();
            if (!formKey) throw new Error('No se pudo obtener el form_key');

            const formData = new FormData();
            formData.append('product', finalProductId);
            formData.append('qty', '1');
            formData.append('form_key', formKey);

            const response = await fetch('/checkout/cart/add', {
                method: 'POST',
                body: formData,
                credentials: 'same-origin'
            });

            if (!response.ok) throw new Error('Error al agregar al carrito');
            return response;
        };

        // =====================================================================
        // CONSTANTS
        // =====================================================================
        const Step = {
            INSTRUCTIONS: 'instructions',
            CONFIRMATION: 'confirmation',
            GENDER: 'gender',
            AGE: 'age',
            WEIGHT: 'weight',
            HEIGHT: 'height',
            RESULT: 'result',
            ERROR: 'error',
        };

        const LoadingState = {
            IDLE: 'idle',
            UPLOADING: 'uploading',
            ANALYZING: 'analyzing',
        };

        const DEFAULT_IMAGES = {
            default: CONFIG.productImage || 'https://placehold.co/600x800/f5f5f5/cccccc?text=Producto',
            user: null,
            result: null,
        };

        // =====================================================================
        // COMPONENTS
        // =====================================================================
        const Loader = ({ message, subMessage }) => (
            <div className="flex flex-col items-center justify-center h-full text-center animate-fade-in">
                <div className="w-[50px] h-[50px] border border-black/10 border-t-black rounded-full mb-8" style={{ animation: 'spin 1s linear infinite' }} />
                <div className="text-[0.9rem] font-semibold uppercase tracking-[0.15em] mb-2 text-black">{message}</div>
                <div className="text-[0.75rem] font-mono text-[#888] min-h-[1.2em]">{subMessage}</div>
            </div>
        );

        const ErrorDisplay = ({ message, onRetry }) => (
            <div className="flex flex-col items-center justify-center h-full text-center animate-fade-in p-8">
                <div className="w-16 h-16 text-red-500 mb-6"><AlertCircleIcon size={64} /></div>
                <h2 className="text-[2.5rem] font-light mb-4 text-black tracking-tight leading-tight">Ocurrió un error</h2>
                <p className="text-[0.9rem] text-[#666] mb-8 max-w-md leading-relaxed">{message}</p>
                <button onClick={onRetry} className="vm-btn-primary-react w-full py-7 px-8 text-[0.85rem] uppercase tracking-[0.15em] font-medium transition-colors">
                    Intentar de nuevo
                </button>
            </div>
        );

        const VisualPanel = ({ imageSrc, loadingState, isReprocessing }) => {
            const isUploading = loadingState === LoadingState.UPLOADING;
            const isAnalyzing = loadingState === LoadingState.ANALYZING;

            return (
                <section className="relative overflow-hidden flex items-center justify-center h-full w-full" style={{ background: 'linear-gradient(135deg, #f8fafc 0%, #e5e7eb 100%)' }}>
                    <div className={`absolute top-0 left-0 w-full h-1 bg-[#a78bfa] z-20 opacity-0 transition-opacity duration-300 ${isAnalyzing ? 'opacity-100 animate-scan' : ''}`} style={{ boxShadow: '0 0 15px #8b5cf6, 0 0 30px #7c3aed' }} />
                    <div className={`absolute inset-0 z-10 opacity-0 transition-opacity duration-500 pointer-events-none ${isAnalyzing ? 'opacity-100' : ''}`}
                        style={{ backgroundImage: `linear-gradient(rgba(124, 58, 237, 0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(124, 58, 237, 0.1) 1px, transparent 1px)`, backgroundSize: '50px 50px' }} />
                    {isAnalyzing && <div className="absolute inset-0 z-10 pointer-events-none" style={{ background: 'linear-gradient(180deg, rgba(76, 29, 149, 0.3) 0%, rgba(124, 58, 237, 0.1) 100%)' }} />}
                    {isReprocessing && (
                        <div className="absolute inset-0 z-20 bg-black/40 backdrop-blur-sm flex items-center justify-center">
                            <div className="flex flex-col items-center gap-3">
                                <div className="w-10 h-10 border-2 border-white/30 border-t-white rounded-full" style={{ animation: 'spin 1s linear infinite' }} />
                                <span className="text-[0.75rem] uppercase tracking-[0.15em] font-medium text-white">Reprocesando...</span>
                            </div>
                        </div>
                    )}
                    {imageSrc ? (
                        <img src={imageSrc} alt="Preview" className={`w-full h-full object-cover transition-all duration-500 ease-in-out
                            ${isUploading ? 'blur-[15px] opacity-50 scale-110 grayscale' : ''}
                            ${isAnalyzing ? 'grayscale contrast-125 brightness-75' : 'opacity-100'}`}
                            style={isAnalyzing ? { mixBlendMode: 'luminosity' } : {}} />
                    ) : (
                        <div className="w-full h-full flex items-center justify-center" style={{ background: 'linear-gradient(135deg, #f8fafc 0%, #e5e7eb 100%)' }}>
                            <span className="text-gray-400 text-sm uppercase tracking-widest">Sin imagen</span>
                        </div>
                    )}
                </section>
            );
        };

        // Mobile visual image component (shown inline on mobile, hidden on desktop)
        const MobileVisualImg = ({ src }) => (
            <img src={src} alt="Visual" className="vm-mobile-img hidden md:!hidden w-full max-h-[350px] object-contain mx-auto mb-5 rounded-lg bg-[#f8fafc]" />
        );

        const Instructions = ({ onUpload, productImage, isUploading }) => {
            const fileInputRef = useRef(null);
            const handleFileChange = (e) => {
                if (e.target.files && e.target.files[0]) onUpload(e.target.files[0]);
            };
            return (
                <div className="flex flex-col h-full md:justify-center">
                    <BusinessLogo />
                    <h2 className="text-[2.5rem] font-light leading-tight tracking-tight mb-5 text-black">Probador Virtual</h2>
                    <MobileVisualImg src={productImage || DEFAULT_IMAGES.default} />
                    <p className="text-[0.9rem] text-[#666] leading-relaxed mb-10 md:mb-14 max-w-[90%]">
                        Sube una foto y permite que nuestra IA analice tu morfología para encontrar el talle perfecto.
                    </p>
                    <div className="flex gap-8 mb-10 md:mb-14">
                        <div className="flex-1">
                            <div className="mb-4 text-black"><SunIcon size={32} /></div>
                            <div className="text-[0.75rem] font-bold uppercase tracking-[0.05em] mb-1.5">Iluminación</div>
                            <div className="text-[0.8rem] text-[#666] leading-snug">Luz natural frontal.</div>
                        </div>
                        <div className="flex-1">
                            <div className="mb-4 text-black"><PersonSimpleIcon size={32} /></div>
                            <div className="text-[0.75rem] font-bold uppercase tracking-[0.05em] mb-1.5">Posición</div>
                            <div className="text-[0.8rem] text-[#666] leading-snug">Cuerpo entero frontal.</div>
                        </div>
                    </div>
                    <input type="file" hidden ref={fileInputRef} accept="image/*" onChange={handleFileChange} disabled={isUploading} />
                    <div className="mt-auto md:mt-0 pt-2">
                        <button type="button" onClick={() => !isUploading && fileInputRef.current?.click()} disabled={isUploading} className="vm-btn-primary-react w-full py-7 px-8 text-[0.85rem] uppercase tracking-[0.15em] font-medium active:scale-[0.99] transition-all flex items-center justify-center gap-3">
                            {isUploading ? (
                                <>
                                    <div className="w-5 h-5 border-2 border-white/30 border-t-white rounded-full" style={{ animation: 'spin 1s linear infinite' }} />
                                    Subiendo...
                                </>
                            ) : 'Subir Foto'}
                        </button>
                        <p className="text-center text-[0.7rem] text-[#999] mt-4">Privacidad asegurada.</p>
                    </div>
                </div>
            );
        };

        const Confirmation = ({ onContinue, onChangePhoto, onChangeMeasurements }) => (
            <div className="flex flex-col">
                <BusinessLogo />
                <h2 className="text-[2.5rem] font-light leading-tight tracking-tight mb-5 text-black">Excelente Toma</h2>
                <MobileVisualImg src={DEFAULT_IMAGES.default} />
                <div className="flex flex-col gap-4 mb-10">
                    <div className="flex items-center gap-4 py-4 border-b border-[#f5f5f5]">
                        <span className="text-black"><CheckCircleIcon size={20} /></span>
                        <span className="text-[0.9rem] font-medium text-[#111]">Iluminación</span>
                        <span className="text-[0.8rem] text-[#888] font-mono ml-auto">100%</span>
                    </div>
                    <div className="flex items-center gap-4 py-4 border-b border-[#f5f5f5]">
                        <span className="text-black"><CheckCircleIcon size={20} /></span>
                        <span className="text-[0.9rem] font-medium text-[#111]">Contraste</span>
                        <span className="text-[0.8rem] text-[#888] font-mono ml-auto">CLARO</span>
                    </div>
                </div>
                <button type="button" onClick={onContinue} className="vm-btn-primary-react w-full py-7 px-8 text-[0.85rem] uppercase tracking-[0.15em] font-medium transition-colors">Continuar</button>
                <button type="button" onClick={onChangePhoto} className="w-full bg-transparent text-[#999] hover:text-black mt-6 text-[0.7rem] uppercase tracking-[0.1em] transition-colors">Cambiar Foto</button>
                <button type="button" onClick={onChangeMeasurements} className="w-full bg-transparent text-[#999] hover:text-black mt-4 text-[0.7rem] uppercase tracking-[0.1em] transition-colors">Cambiar valores corporales</button>
            </div>
        );

        const GenderSelection = ({ selected, onSelect, onNext, onBack }) => {
            const handleSelect = (gender) => { onSelect(gender); setTimeout(onNext, 300); };
            return (
                <div className="flex flex-col h-full">
                    <BusinessLogo />
                    <h2 className="text-[2.5rem] font-light leading-tight tracking-tight mb-5 text-black">¿Cuál es tu género?</h2>
                    <MobileVisualImg src={DEFAULT_IMAGES.default} />
                    <p className="text-[0.9rem] text-[#666] leading-relaxed mb-6">Para optimizar el corte de la prenda.</p>
                    <div className="grid grid-cols-2 gap-5 mt-6">
                        <button onClick={() => handleSelect('female')} className={`border py-10 px-5 flex flex-col items-center gap-4 transition-all duration-300 rounded-sm group cursor-pointer ${selected === 'female' ? 'border-black text-black shadow-lg' : 'border-[#eee] text-[#999] hover:border-black hover:text-black hover:-translate-y-0.5'}`} style={{ transition: 'all 0.3s cubic-bezier(0.25, 1, 0.5, 1)' }}>
                            <GenderFemaleIcon size={40} />
                            <span className="text-[0.9rem] uppercase tracking-[0.1em]">Mujer</span>
                        </button>
                        <button onClick={() => handleSelect('male')} className={`border py-10 px-5 flex flex-col items-center gap-4 transition-all duration-300 rounded-sm group cursor-pointer ${selected === 'male' ? 'border-black text-black shadow-lg' : 'border-[#eee] text-[#999] hover:border-black hover:text-black hover:-translate-y-0.5'}`} style={{ transition: 'all 0.3s cubic-bezier(0.25, 1, 0.5, 1)' }}>
                            <GenderMaleIcon size={40} />
                            <span className="text-[0.9rem] uppercase tracking-[0.1em]">Hombre</span>
                        </button>
                    </div>
                    <div className="mt-auto">
                        <button type="button" onClick={onBack} className="w-full bg-transparent text-[#999] hover:text-black text-[0.7rem] uppercase tracking-[0.1em] transition-colors mt-6">Atrás</button>
                    </div>
                </div>
            );
        };

        const MeasurementInput = ({ title, value, suffix, placeholder, isLastStep = false, onChange, onNext, onBack }) => {
            const inputRef = useRef(null);
            useEffect(() => { const timer = setTimeout(() => inputRef.current?.focus(), 100); return () => clearTimeout(timer); }, []);
            const handleKeyDown = (e) => { if (e.key === 'Enter' && value) onNext(); };
            return (
                <div className="flex flex-col h-full">
                    <BusinessLogo />
                    <h2 className="text-[2.5rem] font-light leading-tight tracking-tight mb-4 text-black">{title}</h2>
                    <MobileVisualImg src={DEFAULT_IMAGES.default} />
                    <div className="relative my-5 mb-10 border-b border-[#e5e5e5] focus-within:border-black transition-colors duration-300">
                        <input ref={inputRef} type="number" value={value} onChange={(e) => onChange(e.target.value)} onKeyDown={handleKeyDown} placeholder={placeholder} className="w-full py-2.5 bg-transparent outline-none text-black placeholder-gray-300" style={{ fontSize: '4rem', fontWeight: 300, fontFamily: "'Inter', sans-serif" }} />
                        <span className="absolute right-0 bottom-[30px] text-base text-[#aaa] tracking-wider lowercase">{suffix}</span>
                    </div>
                    <div className="mt-auto flex flex-col gap-6">
                        <button type="button" onClick={onNext} disabled={!value} className="vm-btn-primary-react w-full py-7 px-8 text-[0.85rem] uppercase tracking-[0.15em] font-medium transition-colors disabled:cursor-not-allowed">
                            {isLastStep ? 'Analizar' : 'Siguiente'}
                        </button>
                        <button type="button" onClick={onBack} className="w-full bg-transparent text-[#999] hover:text-black text-[0.7rem] uppercase tracking-[0.1em] transition-colors">Atrás</button>
                    </div>
                </div>
            );
        };

        // Obtener sizes y colors dinámicamente de CONFIG
        const SIZES = CONFIG.options.sizes.length > 0 ? CONFIG.options.sizes : ['M', 'L', 'XL'];

        const colorMap = {
            'Black': '#1a1a1a',
            'Gray': '#808080', 
            'Green': '#22c55e',
            'Blue': '#3b82f6',
            'Red': '#ef4444',
            'White': '#ffffff',
            'Yellow': '#fbbf24',
            'Orange': '#f97316',
            'Purple': '#a855f7'
        };

        const COLORS_NAMES = CONFIG.options.colors.length > 0 ? CONFIG.options.colors : ['Black', 'Gray', 'Green'];
        const COLORS = COLORS_NAMES.map(name => ({ 
            name, 
            hex: colorMap[name] || '#999999' 
        }));

        const Result = ({ userData, resultImage, recommendedSize, onReset, onReprocess, isReprocessing }) => {
            const isSimpleProduct = Object.keys(CONFIG.configurations).length === 0 && 
                                CONFIG.options.sizes.length === 0 && 
                                CONFIG.options.colors.length === 0;
            
            const [selectedSize, setSelectedSize] = useState(recommendedSize || SIZES[1] || 'L');
            const [selectedColor, setSelectedColor] = useState(COLORS[0]?.name || 'Black');
            const [isAdding, setIsAdding] = useState(false);
            const debounceTimer = useRef(null);

            const titles = userData.gender === 'male'
                ? ['Te queda impecable', 'Ajuste Perfecto', 'Gran Estilo']
                : ['Estás radiante', 'Te queda divino', 'Silueta Perfecta'];
            const [randomTitle] = useState(() => titles[Math.floor(Math.random() * titles.length)]);

            // Debounced reprocessing only when COLOR changes (not size)
            const isFirstColorRender = useRef(true);
            useEffect(() => {
                if (isFirstColorRender.current) {
                    isFirstColorRender.current = false;
                    return;
                }
                if (isSimpleProduct) return;

                if (debounceTimer.current) clearTimeout(debounceTimer.current);
                debounceTimer.current = setTimeout(() => {
                    const key = `${selectedSize}-${selectedColor}`;
                    const variantId = CONFIG.configurations[key] || null;
                    const clothImageUrl = CONFIG.variantImages[selectedColor] || null;
                    onReprocess({
                        variantId,
                        variantValues: { size: selectedSize, color: selectedColor },
                        clothImageUrl
                    });
                }, 800);

                return () => { if (debounceTimer.current) clearTimeout(debounceTimer.current); };
            }, [selectedColor]);

            const handleAddToCart = async () => {
                try {
                    setIsAdding(true);
                    
                    if (isSimpleProduct) {
                        await addToCart(CONFIG.productId, null, null);
                    } else {
                        await addToCart(CONFIG.productId, selectedSize, selectedColor);
                    }
                    
                    // Invalidar y recargar el mini-cart usando el sistema nativo de Magento
                    window.parent.require(['Magento_Customer/js/customer-data'], function(customerData) {
                        customerData.invalidate(['cart']);
                        customerData.reload(['cart'], true);
                    });

                    window.parent.document.getElementById('clostech-modal').style.display = 'none';
                    window.parent.location.reload();
                } catch (error) {
                    console.error('Error agregando al carrito:', error);
                    alert('Error al agregar al carrito. Por favor, intenta de nuevo.');
                } finally {
                    setIsAdding(false);
                }
            };

            const handleWhatsapp = () => {
                const text = `¡Mira cómo me queda esta prenda! Mi talla ideal es ${selectedSize} según Clostech AI.`;
                window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank');
            };

            const getLabel = (size) => {
                const sizeIndex = SIZES.indexOf(size);
                const recommendedIndex = SIZES.indexOf(recommendedSize);
                
                if (size === recommendedSize) return 'Recomendación';
                if (sizeIndex < recommendedIndex) return 'Ajustada';
                return 'Suelta';
            };

            return (
                <div className="flex flex-col animate-fade-in h-full">
                    <div className="flex items-center gap-2 text-[0.7rem] uppercase tracking-[0.2em] font-semibold text-black mb-7">
                        <span className="w-1.5 h-1.5 bg-green-500 rounded-full"></span>
                        Match: 98%
                    </div>
                    <h2 className="text-[2.5rem] font-light leading-tight tracking-tight mb-5 text-black">{randomTitle}</h2>
                    <div className="relative md:hidden">
                        <MobileVisualImg src={resultImage || DEFAULT_IMAGES.default} />
                        {isReprocessing && (
                            <div className="absolute inset-0 bg-white/80 backdrop-blur-sm flex items-center justify-center rounded-lg z-10">
                                <div className="flex flex-col items-center gap-3">
                                    <div className="w-8 h-8 border border-black/10 border-t-black rounded-full" style={{ animation: 'spin 1s linear infinite' }} />
                                    <span className="text-[0.75rem] uppercase tracking-[0.15em] font-medium text-black">Reprocesando...</span>
                                </div>
                            </div>
                        )}
                    </div>
                    <p className="text-[0.9rem] text-[#444] leading-relaxed mb-10">
                        La IA recomienda <strong className="text-black font-semibold">Talla {selectedSize}</strong> para ti
                    </p>

                    {/* Size scale: sizes on top, line in middle, labels below */}
                    <div className="w-full max-w-[320px] mx-auto mb-12 select-none">
                        {/* Size letters - selectable for cart, no reprocessing */}
                        <div className="flex justify-between items-end w-full px-1 mb-3">
                            {SIZES.map((size) => {
                                const isSelected = selectedSize === size;
                                return (
                                    <button key={size} onClick={() => setSelectedSize(size)} className="flex flex-col items-center focus:outline-none cursor-pointer" style={{ minWidth: '50px' }}>
                                        <span className={`text-base leading-none transition-all duration-300 ${isSelected ? 'text-black font-bold' : 'text-[#999] font-normal'}`}>{size}</span>
                                    </button>
                                );
                            })}
                        </div>
                        {/* Horizontal line */}
                        <div className="w-full h-[1px] bg-[#e5e5e5] mx-auto"></div>
                        {/* Labels below */}
                        <div className="flex justify-between items-start w-full px-1 mt-3">
                            {SIZES.map((size) => {
                                const isSelected = selectedSize === size;
                                return (
                                    <div key={size} className="flex flex-col items-center" style={{ minWidth: '50px' }}>
                                        <span className={`text-[0.7rem] leading-snug transition-all duration-300 ${isSelected ? 'text-black font-semibold' : 'text-[#999]'}`}>{getLabel(size)}</span>
                                    </div>
                                );
                            })}
                        </div>
                    </div>

                    <div className="flex gap-3 mb-auto">
                        {COLORS.map((color) => (
                            <button 
                                key={color.name} 
                                onClick={() => setSelectedColor(color.name)}
                                className={`w-8 h-8 rounded-full relative transition-all duration-200 hover:scale-105`}
                                style={{ 
                                    backgroundColor: color.hex,
                                    border: '1px solid rgba(0,0,0,0.1)',
                                    ...(selectedColor === color.name ? { outline: '1px solid #000', outlineOffset: '3px' } : {})
                                }}
                                title={color.name}
                            />
                        ))}
                    </div>

                    <div className="mt-12">
                        <div className="grid grid-cols-[1fr_auto_auto] gap-3 mb-4">
                            <button 
                                onClick={handleAddToCart}
                                disabled={isAdding || isReprocessing}
                                className="vm-btn-primary-react flex items-center justify-center gap-3 py-7 px-8 text-[0.85rem] uppercase tracking-[0.15em] font-medium transition-colors active:scale-[0.99] disabled:!opacity-50 disabled:cursor-not-allowed"
                            >
                                <ShoppingBagIcon size={18} />
                                <span>{isAdding ? 'Agregando...' : `Añadir Talla ${selectedSize}`}</span>
                            </button>
                            <button onClick={handleWhatsapp} className="w-[50px] bg-white border border-[#e5e5e5] flex items-center justify-center hover:border-[#25D366] hover:text-[#25D366] transition-all text-[#555]">
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round">
                                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
                                </svg>
                            </button>
                            <button className="w-[50px] bg-white border border-[#e5e5e5] flex items-center justify-center hover:border-black hover:text-black transition-all text-[#555]">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                    <polyline points="7 10 12 15 17 10" />
                                    <line x1="12" y1="15" x2="12" y2="3" />
                                </svg>
                            </button>
                        </div>
                        <button type="button" onClick={onReset} className="w-full text-center text-[#999] hover:text-black text-[0.7rem] uppercase tracking-[0.1em] transition-colors py-2 mt-4">Probar otra prenda</button>
                    </div>
                </div>
            );
        };

        const ControlPanel = ({ step, loadingState, loadingMessage, loadingSubMessage, userData, productImage, resultImage, recommendedSize, errorMessage, isReprocessing, isUploading, onUpload, onReset, onClose, onUpdateUser, onNext, onBack, onAnalyze, onChangeMeasurements, onReprocess }) => {
            const renderStep = () => {
                switch (step) {
                    case Step.INSTRUCTIONS: return <Instructions onUpload={onUpload} productImage={productImage} isUploading={isUploading} />;
                    case Step.CONFIRMATION: return <Confirmation onContinue={onNext} onChangePhoto={onReset} onChangeMeasurements={onChangeMeasurements} />;
                    case Step.GENDER: return <GenderSelection selected={userData.gender} onSelect={(gender) => onUpdateUser({ gender })} onNext={onNext} onBack={onBack} />;
                    case Step.AGE: return <MeasurementInput title="¿Cuál es tu edad?" value={userData.age} suffix="años" placeholder="00" onChange={(val) => onUpdateUser({ age: val })} onNext={onNext} onBack={onBack} />;
                    case Step.WEIGHT: return <MeasurementInput title="¿Cuánto pesas?" value={userData.weight} suffix="kg" placeholder="00" onChange={(val) => onUpdateUser({ weight: val })} onNext={onNext} onBack={onBack} />;
                    case Step.HEIGHT: return <MeasurementInput title="¿Cuál es tu altura?" value={userData.height} suffix="cm" placeholder="000" onChange={(val) => onUpdateUser({ height: val })} onNext={onAnalyze} onBack={onBack} isLastStep />;
                    case Step.RESULT: return <Result userData={userData} resultImage={resultImage} recommendedSize={recommendedSize} onReset={onReset} onReprocess={onReprocess} isReprocessing={isReprocessing} />;
                    case Step.ERROR: return <ErrorDisplay message={errorMessage} onRetry={onReset} />;
                    default: return null;
                }
            };

            return (
                <section className="relative flex-1 bg-white overflow-hidden">
                    <div className="h-full w-full overflow-y-auto no-scrollbar">
                        <div className="flex flex-col min-h-full py-6 px-5 md:py-[70px] md:px-[60px] justify-center">
                            <div className="absolute top-0 right-0 p-5 md:p-8 z-10">
                                <button onClick={onClose} className="text-[#111] hover:rotate-90 transition-transform duration-300 cursor-pointer" style={{ fontSize: '32px' }}>
                                    <XIcon size={28} />
                                </button>
                            </div>
                            {loadingState !== LoadingState.IDLE && (
                                <div className="absolute inset-0 z-20 bg-white flex items-center justify-center">
                                    <Loader message={loadingMessage} subMessage={loadingSubMessage} />
                                </div>
                            )}
                            {loadingState === LoadingState.IDLE && (
                                <div className="w-full max-w-md mx-auto animate-fade-in py-8 md:py-0 h-full flex flex-col md:block">
                                    {renderStep()}
                                </div>
                            )}
                            {/* Footer branding */}
                            <div className="mt-auto pt-10 w-full flex justify-center gap-3 items-center text-[11px] text-[#9ca3af] font-normal tracking-wide pb-5 flex-shrink-0">
                                <a href="https://clostech.tech" target="_blank" rel="noopener noreferrer" className="text-[#9ca3af] no-underline hover:text-[#6b7280] transition-colors">
                                    By Clostech
                                </a>
                                <span className="text-[#d1d5db]">•</span>
                                <a href="https://clostech.tech/privacidad" target="_blank" rel="noopener noreferrer" className="text-[#9ca3af] no-underline hover:text-[#6b7280] transition-colors">
                                    Privacidad
                                </a>
                            </div>
                        </div>
                    </div>
                </section>
            );
        };

        // =====================================================================
        // MAIN APP
        // =====================================================================
        const INITIAL_USER_DATA = { gender: '', age: '', weight: '', height: '' };
        const INITIAL_STATE = {
            step: Step.INSTRUCTIONS,
            loadingState: LoadingState.IDLE,
            loadingMessage: '',
            loadingSubMessage: '',
            userData: INITIAL_USER_DATA,
            previewImage: DEFAULT_IMAGES.default,
            userImageUrl: null,
            resultImage: null,
            recommendedSize: null,
            errorMessage: null,
            userFile: null,
            isReprocessing: false,
            isUploading: false,
        };

        const App = () => {
            const [state, setState] = useState(INITIAL_STATE);
            const [storeStyles, setStoreStyles] = useState(null);

            // Fetch store customizations on mount (same endpoint as main.js)
            useEffect(() => {
                if (!CONFIG.storeId) { console.warn('[Clostech] No storeId - skipping customizations fetch'); return; }
                console.log('[Clostech] Fetching customizations for store:', CONFIG.storeId);
                fetch(`${CLOSTECH_API_URL}/api/stores/${CONFIG.storeId}/customizations`, {
                    headers: { 'ngrok-skip-browser-warning': 'true' }
                })
                .then(res => { console.log('[Clostech] Customizations response:', res.status); return res.ok ? res.json() : null; })
                .then(data => {
                    if (!data) { console.warn('[Clostech] No customization data'); return; }
                    console.log('[Clostech] Customizations loaded:', data);
                    setStoreStyles(data);
                    // Apply button colors as CSS variables
                    const root = document.documentElement;
                    const btnBg = data.modal_action_button_background_color || data.button_type || CONFIG.btnBg;
                    const btnText = data.modal_action_button_text_color || data.button_text_color || CONFIG.btnText;
                    const btnHoverBg = data.modal_action_button_hover_background_color || data.button_hover_background_color || CONFIG.btnHoverBg;
                    const btnHoverText = data.modal_action_button_hover_text_color || data.button_hover_text_color || CONFIG.btnHoverText;
                    root.style.setProperty('--btn-bg', btnBg);
                    root.style.setProperty('--btn-text', btnText);
                    root.style.setProperty('--btn-hover-bg', btnHoverBg);
                    root.style.setProperty('--btn-hover-text', btnHoverText);
                    // Store business logo in CONFIG for components to use
                    if (data.modal_avatar_business_logo) {
                        CONFIG.businessLogo = data.modal_avatar_business_logo;
                    }
                    // Use store avatar as default visual image (like main.js)
                    if (data.modal_avatar_url) {
                        CONFIG.storeAvatar = data.modal_avatar_url;
                        // Update preview image if still on instructions step
                        setState(prev => prev.step === Step.INSTRUCTIONS 
                            ? { ...prev, previewImage: data.modal_avatar_url }
                            : prev
                        );
                    }
                })
                .catch((err) => { console.error('[Clostech] Error fetching customizations:', err); });
            }, []);

            const updateState = (updates) => setState((prev) => ({ ...prev, ...updates }));
            const updateUserData = (updates) => setState((prev) => ({ ...prev, userData: { ...prev.userData, ...updates } }));

            // Ref to hold the background AI promise (fired on "Continuar")
            const aiPromiseRef = useRef(null);

            const handleUpload = async (file) => {
                const objectUrl = URL.createObjectURL(file);
                updateState({ 
                    previewImage: objectUrl, 
                    userFile: file,
                    isUploading: true
                });

                try {
                    const userImageUrl = await uploadUserPhoto(file);
                    updateState({ 
                        isUploading: false,
                        userImageUrl: userImageUrl,
                        step: Step.CONFIRMATION 
                    });
                } catch (error) {
                    console.error('Error subiendo foto:', error);
                    updateState({ 
                        isUploading: false,
                        step: Step.ERROR,
                        errorMessage: 'Error al subir la imagen. Por favor, intenta de nuevo.'
                    });
                }
            };

            const handleReset = () => {
                aiPromiseRef.current = null;
                setState(INITIAL_STATE);
            };

            const handleClose = () => {
                aiPromiseRef.current = null;
                setState(INITIAL_STATE);
                try {
                    const parentModal = window.parent.document.getElementById('clostech-modal');
                    if (parentModal) parentModal.style.display = 'none';
                } catch(e) {}
            };

            // "Cambiar valores corporales" → go to gender step keeping the photo
            const handleChangeMeasurements = () => {
                updateState({ 
                    userData: INITIAL_USER_DATA,
                    step: Step.GENDER 
                });
            };

            const handleNext = () => {
                switch (state.step) {
                    case Step.CONFIRMATION:
                        // Fire AI in background while user fills body data
                        console.log('[Clostech] CONFIG values:', { storeId: CONFIG.storeId, clientId: CONFIG.clientId, apiKey: CONFIG.apiKey, productId: CONFIG.productId });
                        console.log('[Clostech] userImageUrl:', state.userImageUrl);
                        if (state.userImageUrl) {
                            console.log('[Clostech] Firing AI in background...');
                            aiPromiseRef.current = processWithAI(state.userImageUrl)
                                .then(result => {
                                    console.log('[Clostech] Background AI completed');
                                    return result;
                                })
                                .catch(err => {
                                    console.error('[Clostech] Background AI error:', err);
                                    throw err;
                                });
                        }
                        updateState({ step: Step.GENDER });
                        break;
                    case Step.GENDER: updateState({ step: Step.AGE }); break;
                    case Step.AGE: updateState({ step: Step.WEIGHT }); break;
                    case Step.WEIGHT: updateState({ step: Step.HEIGHT }); break;
                    default: break;
                }
            };

            const handleBack = () => {
                switch (state.step) {
                    case Step.GENDER: updateState({ step: Step.CONFIRMATION }); break;
                    case Step.AGE: updateState({ step: Step.GENDER }); break;
                    case Step.WEIGHT: updateState({ step: Step.AGE }); break;
                    case Step.HEIGHT: updateState({ step: Step.WEIGHT }); break;
                    default: break;
                }
            };

            const handleAnalyze = async () => {
                try {
                    updateState({ 
                        loadingState: LoadingState.ANALYZING, 
                        loadingMessage: 'Analizando con IA...', 
                        loadingSubMessage: 'CALCULANDO TALLE IDEAL'
                    });

                    let result;

                    if (aiPromiseRef.current) {
                        // AI was already fired in background on "Continuar"
                        result = await aiPromiseRef.current;
                    } else {
                        // Fallback: fire AI now (shouldn't normally happen)
                        console.warn('[Clostech] AI not fired in background, firing now');
                        result = await processWithAI(state.userImageUrl);
                    }

                    saveUsageToLocalStorage(result.result_image_url);

                    updateState({ 
                        loadingState: LoadingState.IDLE, 
                        step: Step.RESULT, 
                        resultImage: result.result_image_url,
                        previewImage: result.result_image_url,
                        recommendedSize: result.recommended_size || SIZES[1] || 'L'
                    });

                } catch (error) {
                    console.error('Error en análisis:', error);
                    updateState({ 
                        loadingState: LoadingState.IDLE, 
                        step: Step.ERROR,
                        errorMessage: error.message || 'Ocurrió un error inesperado'
                    });
                }
            };

            const isInstructionStep = state.step === Step.INSTRUCTIONS;

            // Reprocess AI with new variant (color/size change)
            const handleReprocess = async ({ variantId, variantValues, clothImageUrl }) => {
                if (!state.userImageUrl) return;
                
                try {
                    updateState({ isReprocessing: true });

                    const result = await processWithAI(state.userImageUrl, { variantId, variantValues, clothImageUrl });

                    updateState({ 
                        isReprocessing: false,
                        resultImage: result.result_image_url,
                        previewImage: result.result_image_url,
                    });
                } catch (error) {
                    console.error('Error en reprocesamiento:', error);
                    updateState({ isReprocessing: false });
                }
            };

            return (
                <main className="w-full h-full md:h-auto md:w-[90%] md:max-w-[1100px] bg-white md:shadow-[0_50px_100px_-20px_rgba(0,0,0,0.25)] overflow-hidden flex flex-col md:grid md:grid-cols-[45%_55%] md:min-h-[650px] md:rounded-none rounded-xl md:max-h-none" style={{ maxHeight: window.innerWidth < 768 ? '85vh' : 'none' }}>
                    <div className={`${isInstructionStep ? 'hidden md:block' : 'hidden md:block'} w-full h-full`}>
                        <VisualPanel imageSrc={state.previewImage} loadingState={state.loadingState} isReprocessing={state.isReprocessing} />
                    </div>
                    <ControlPanel
                        step={state.step}
                        loadingState={state.loadingState}
                        loadingMessage={state.loadingMessage}
                        loadingSubMessage={state.loadingSubMessage}
                        userData={state.userData}
                        productImage={CONFIG.productImage}
                        resultImage={state.resultImage}
                        recommendedSize={state.recommendedSize}
                        errorMessage={state.errorMessage}
                        isReprocessing={state.isReprocessing}
                        isUploading={state.isUploading}
                        onUpload={handleUpload}
                        onReset={handleReset}
                        onClose={handleClose}
                        onUpdateUser={updateUserData}
                        onNext={handleNext}
                        onBack={handleBack}
                        onAnalyze={handleAnalyze}
                        onChangeMeasurements={handleChangeMeasurements}
                        onReprocess={handleReprocess}
                    />
                </main>
            );
        };

        const root = createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>

</html>

