<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Clostech Virtual Fitting Room</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100;300;400;500;600;700&display=swap"
        rel="stylesheet" />

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- React & ReactDOM -->
    <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>

    <!-- Lucide Icons (Core) -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Babel para procesar React (JSX) en el navegador -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            overscroll-behavior-y: none;
        }

        @keyframes scanMove {
            0% { top: 0%; opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { top: 100%; opacity: 0; }
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .animate-scan { animation: scanMove 2.5s ease-in-out infinite; }
        .animate-fade-in { animation: fadeIn 0.6s ease forwards; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>

<body class="bg-[#f5f5f5] text-[#111111] antialiased h-[100dvh] w-full overflow-hidden flex items-center justify-center p-0 md:p-10">

    <!-- React Root -->
    <div id="root" class="w-full h-full flex items-center justify-center"></div>

    <!-- Application Logic -->
    <script type="text/babel">
        const { useState, useEffect, useRef } = React;
        const { createRoot } = ReactDOM;

        // =====================================================================
        // ICONS
        // =====================================================================
        const Icon = ({ name, size = 24, strokeWidth = 2, className = "", ...props }) => {
            if (typeof lucide === 'undefined') return null;
            const icon = lucide.icons[name];
            if (!icon) return null;
            const svg = icon.toSvg({ width: size, height: size, 'stroke-width': strokeWidth, class: className, ...props });
            return <span dangerouslySetInnerHTML={{ __html: svg }} className="inline-flex items-center justify-center" />;
        };

        const Sun = (props) => <Icon name="sun" {...props} />;
        const User = (props) => <Icon name="user" {...props} />;
        const UploadCloud = (props) => <Icon name="upload-cloud" {...props} />;
        const CheckCircle2 = (props) => <Icon name="check-circle-2" {...props} />;
        const CircleUser = (props) => <Icon name="circle-user" {...props} />;
        const X = (props) => <Icon name="x" {...props} />;
        const ShoppingBag = (props) => <Icon name="shopping-bag" {...props} />;
        const MessageCircle = (props) => <Icon name="message-circle" {...props} />;
        const Download = (props) => <Icon name="download" {...props} />;
        const AlertCircle = (props) => <Icon name="alert-circle" {...props} />;

        // =====================================================================
        // CONFIG - Leer parámetros de URL
        // =====================================================================
        const getUrlParams = () => {
            const params = new URLSearchParams(window.location.search);
            return {
                productId: params.get('product_id') || null,
                productSku: params.get('product_sku') || null,
                productName: params.get('product_name') || null,
                productImage: params.get('product_image') || null,
                storeId: params.get('store_id') || null,
                apiKey: params.get('api_key') || null,
                clientId: params.get('client_id') || null,
                configurations: JSON.parse(params.get('configurations') || '{}'),
                options: JSON.parse(params.get('options') || '{"sizes":[],"colors":[]}')
            };
        };

        const CONFIG = getUrlParams();
        const CLOSTECH_API_URL = 'https://portal-empresa.clostech.tech';

        // =====================================================================
        // API FUNCTIONS
        // =====================================================================
        const uploadUserPhoto = async (file) => {
            const formData = new FormData();
            formData.append('file', file);

            const response = await fetch(`${CLOSTECH_API_URL}/api/upload-image`, {
                method: 'POST',
                body: formData,
            });

            if (!response.ok) throw new Error('Error al subir la imagen');
            
            const data = await response.json();
            if (!data.url) throw new Error('No se recibió URL de imagen');
            
            return data.url;
        };

        const processWithAI = async (userImageUrl) => {
            const response = await fetch(`${CLOSTECH_API_URL}/api/ai-v2`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    api_key: CONFIG.apiKey,
                    store_id: CONFIG.storeId,
                    client_id: CONFIG.clientId,
                    product_id: CONFIG.productId,
                    variant_id: null,
                    variant_values: null,
                    user_image_url: userImageUrl,
                    cloth_image_url: CONFIG.productImage,
                }),
            });

            if (!response.ok) throw new Error('Error en el procesamiento de IA');
            
            const apiResponse = await response.json();
            
            // Transformar respuesta de API al formato esperado
            if (!apiResponse.success || !apiResponse.data?.generated_image_url) {
                throw new Error('No se recibió resultado de IA');
            }
            
            return {
                result_image_url: apiResponse.data.generated_image_url,
                recommended_size: 'L' // Por defecto
            };
        };

        const saveUsageToLocalStorage = (resultImageUrl) => {
            const tryOnData = {
                productId: CONFIG.productId,
                productName: CONFIG.productName,
                productSku: CONFIG.productSku,
                timestamp: Date.now(),
                imageUrl: resultImageUrl,
                used: true
            };
            localStorage.setItem(`clostech_tryon_${CONFIG.productId}`, JSON.stringify(tryOnData));
            localStorage.setItem('use_clostech', 'true');
        };

        // Obtener form_key de Magento para CSRF protection
        const getFormKey = () => {
            const formKeyInput = window.parent.document.querySelector('input[name="form_key"]');
            return formKeyInput ? formKeyInput.value : null;
        };

        // Agregar producto al carrito
        const addToCart = async (productId, size, color) => {
            // Si hay configuraciones, buscar el producto hijo
            let finalProductId = productId;
            
            if (Object.keys(CONFIG.configurations).length > 0) {
                // Producto configurable - buscar hijo
                const key = `${size}-${color}`;
                const childId = CONFIG.configurations[key];
                
                if (childId) {
                    finalProductId = childId;
                    console.log(`Producto configurable: usando hijo ${childId} para ${key}`);
                } else {
                    console.warn(`No se encontró producto hijo para ${key}`, CONFIG.configurations);
                    throw new Error(`No hay stock disponible para ${size}-${color}`);
                }
            }
            
            const formKey = getFormKey();
            if (!formKey) throw new Error('No se pudo obtener el form_key');

            const formData = new FormData();
            formData.append('product', finalProductId);
            formData.append('qty', '1');
            formData.append('form_key', formKey);

            const response = await fetch('/checkout/cart/add', {
                method: 'POST',
                body: formData,
                credentials: 'same-origin'
            });

            if (!response.ok) throw new Error('Error al agregar al carrito');
            return response;
        };

        // =====================================================================
        // CONSTANTS
        // =====================================================================
        const Step = {
            INSTRUCTIONS: 'instructions',
            CONFIRMATION: 'confirmation',
            GENDER: 'gender',
            AGE: 'age',
            WEIGHT: 'weight',
            HEIGHT: 'height',
            RESULT: 'result',
            ERROR: 'error',
        };

        const LoadingState = {
            IDLE: 'idle',
            UPLOADING: 'uploading',
            ANALYZING: 'analyzing',
        };

        const DEFAULT_IMAGES = {
            default: CONFIG.productImage || 'https://placehold.co/600x800/f5f5f5/cccccc?text=Producto',
            user: null,
            result: null,
        };

        // =====================================================================
        // COMPONENTS
        // =====================================================================
        const Loader = ({ message, subMessage }) => (
            <div className="flex flex-col items-center justify-center h-full text-center animate-fade-in">
                <div className="w-12 h-12 border border-black/10 border-t-black rounded-full mb-8" style={{ animation: 'spin 1s linear infinite' }} />
                <div className="text-sm font-semibold uppercase tracking-[0.15em] mb-2 text-black">{message}</div>
                <div className="text-xs font-mono text-gray-400">{subMessage}</div>
            </div>
        );

        const ErrorDisplay = ({ message, onRetry }) => (
            <div className="flex flex-col items-center justify-center h-full text-center animate-fade-in p-8">
                <AlertCircle className="w-16 h-16 text-red-500 mb-6" />
                <h2 className="text-2xl font-light mb-4 text-black">Ocurrió un error</h2>
                <p className="text-sm text-gray-500 mb-8 max-w-md">{message}</p>
                <button onClick={onRetry} className="bg-black text-white px-8 py-4 text-sm uppercase tracking-widest hover:bg-zinc-800 transition-colors">
                    Intentar de nuevo
                </button>
            </div>
        );

        const VisualPanel = ({ imageSrc, loadingState }) => {
            const isUploading = loadingState === LoadingState.UPLOADING;
            const isAnalyzing = loadingState === LoadingState.ANALYZING;

            return (
                <section className="relative bg-black overflow-hidden flex items-center justify-center h-[30vh] md:h-auto min-h-[300px] md:min-h-[650px] w-full">
                    <div className={`absolute top-0 left-0 w-full h-1 bg-violet-400 shadow-[0_0_15px_#8b5cf6,0_0_30px_#7c3aed] z-20 opacity-0 transition-opacity duration-300 ${isAnalyzing ? 'opacity-100 animate-scan' : ''}`} />
                    <div className={`absolute inset-0 z-10 opacity-0 transition-opacity duration-500 pointer-events-none ${isAnalyzing ? 'opacity-100' : ''}`}
                        style={{ backgroundImage: `linear-gradient(rgba(124, 58, 237, 0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(124, 58, 237, 0.1) 1px, transparent 1px)`, backgroundSize: '50px 50px' }} />
                    {isAnalyzing && <div className="absolute inset-0 bg-gradient-to-b from-purple-900/30 to-violet-600/10 z-10 pointer-events-none" />}
                    {imageSrc ? (
                        <img src={imageSrc} alt="Preview" className={`w-full h-full object-cover transition-all duration-700 ease-in-out
                            ${isUploading ? 'blur-md opacity-50 scale-110 grayscale' : ''}
                            ${isAnalyzing ? 'grayscale contrast-125 brightness-75 mix-blend-luminosity' : 'opacity-100'}`} />
                    ) : (
                        <div className="w-full h-full bg-gray-900 flex items-center justify-center">
                            <span className="text-gray-600 text-sm uppercase tracking-widest">Sin imagen</span>
                        </div>
                    )}
                </section>
            );
        };

        const Instructions = ({ onUpload, productImage }) => {
            const fileInputRef = useRef(null);
            const handleFileChange = (e) => {
                if (e.target.files && e.target.files[0]) onUpload(e.target.files[0]);
            };
            return (
                <div className="flex flex-col h-full md:justify-center">
                    <div className="flex items-center gap-2 text-[10px] md:text-xs uppercase tracking-[0.2em] font-semibold text-gray-400 mb-3 md:mb-6">
                        <span className="w-1.5 h-1.5 bg-black rounded-full"></span>
                        Clostech
                    </div>
                    <h2 className="text-[2.5rem] md:text-[2.5rem] font-light leading-[0.9] tracking-tight mb-4 text-black">Probador Virtual</h2>
                    <p className="text-xs md:text-sm text-gray-500 leading-relaxed mb-6 md:mb-8 max-w-[90%]">
                        Sube una foto y permite que nuestra IA analice tu morfología para encontrar el talle perfecto.
                    </p>
                    <div className="flex gap-4 md:gap-6 mb-6 md:mb-8">
                        <div className="flex-1">
                            <Sun className="w-6 h-6 mb-2 text-black stroke-1" />
                            <div className="text-[10px] font-bold uppercase tracking-wider mb-1">Iluminación</div>
                            <div className="text-[10px] md:text-[11px] text-gray-500 leading-tight">Luz natural frontal.</div>
                        </div>
                        <div className="flex-1">
                            <User className="w-6 h-6 mb-2 text-black stroke-1" />
                            <div className="text-[10px] font-bold uppercase tracking-wider mb-1">Posición</div>
                            <div className="text-[10px] md:text-[11px] text-gray-500 leading-tight">Cuerpo entero.</div>
                        </div>
                    </div>
                    {productImage && (
                        <div className="md:hidden relative w-full aspect-[4/3] mb-6 rounded-sm overflow-hidden bg-gray-50 border border-gray-100 shadow-sm">
                            <img src={productImage} alt="Producto" className="w-full h-full object-cover opacity-90" />
                            <div className="absolute top-3 left-3 bg-white/90 backdrop-blur text-black text-[9px] px-2 py-1 rounded-sm uppercase tracking-widest font-bold shadow-sm border border-gray-200 z-10">Producto</div>
                        </div>
                    )}
                    <input type="file" hidden ref={fileInputRef} accept="image/*" onChange={handleFileChange} />
                    <div className="mt-auto md:mt-0 pt-2">
                        <button type="button" onClick={() => fileInputRef.current?.click()} className="w-full bg-black text-white border border-black p-5 text-xs md:text-sm uppercase tracking-[0.15em] font-medium hover:bg-zinc-800 active:scale-[0.98] transition-all flex items-center justify-center gap-3">
                            <UploadCloud size={18} />
                            Subir Foto
                        </button>
                        <p className="text-center text-[0.65rem] text-gray-400 mt-4 md:pb-0">Privacidad asegurada · Procesamiento seguro</p>
                    </div>
                </div>
            );
        };

        const Confirmation = ({ onContinue, onChangePhoto }) => (
            <div className="flex flex-col">
                <div className="flex items-center gap-2 text-xs uppercase tracking-[0.2em] font-semibold text-green-500 mb-6">
                    <span className="w-1.5 h-1.5 bg-green-500 rounded-full"></span>
                    Foto Recibida
                </div>
                <h2 className="text-4xl md:text-[2.5rem] font-light leading-none tracking-tight mb-8 text-black">Excelente Toma</h2>
                <div className="flex flex-col gap-4 mb-10">
                    <div className="flex items-center gap-4 py-4 border-b border-gray-100">
                        <CheckCircle2 className="w-5 h-5 text-black" />
                        <span className="text-sm font-medium text-gray-900">Imagen cargada</span>
                        <span className="text-xs text-gray-400 font-mono ml-auto">OK</span>
                    </div>
                </div>
                <button type="button" onClick={onContinue} className="w-full bg-black text-white border border-black p-5 text-sm uppercase tracking-[0.15em] font-medium hover:bg-zinc-800 transition-colors">Continuar</button>
                <button type="button" onClick={onChangePhoto} className="w-full bg-transparent text-gray-400 hover:text-black mt-6 text-xs uppercase tracking-[0.1em] transition-colors">Cambiar Foto</button>
            </div>
        );

        const GenderSelection = ({ selected, onSelect, onNext, onBack }) => {
            const handleSelect = (gender) => { onSelect(gender); setTimeout(onNext, 300); };
            return (
                <div className="flex flex-col h-full">
                    <div className="flex items-center gap-2 text-xs uppercase tracking-[0.2em] font-semibold text-gray-400 mb-6">
                        <span className="w-1.5 h-1.5 bg-black rounded-full"></span>
                        Datos Corporales
                    </div>
                    <h2 className="text-4xl md:text-[2.5rem] font-light leading-none tracking-tight mb-4 text-black">¿Cuál es tu género?</h2>
                    <p className="text-sm text-gray-500 leading-relaxed mb-8">Para optimizar el corte de la prenda.</p>
                    <div className="grid grid-cols-2 gap-5 mb-8">
                        <button onClick={() => handleSelect('female')} className={`border p-10 flex flex-col items-center gap-4 transition-all duration-300 rounded-sm group ${selected === 'female' ? 'border-black text-black shadow-lg' : 'border-gray-100 text-gray-400 hover:border-black hover:text-black hover:-translate-y-1'}`}>
                            <CircleUser className="w-10 h-10 stroke-1" />
                            <span className="text-sm uppercase tracking-[0.1em]">Mujer</span>
                        </button>
                        <button onClick={() => handleSelect('male')} className={`border p-10 flex flex-col items-center gap-4 transition-all duration-300 rounded-sm group ${selected === 'male' ? 'border-black text-black shadow-lg' : 'border-gray-100 text-gray-400 hover:border-black hover:text-black hover:-translate-y-1'}`}>
                            <User className="w-10 h-10 stroke-1" />
                            <span className="text-sm uppercase tracking-[0.1em]">Hombre</span>
                        </button>
                    </div>
                    <div className="mt-auto">
                        <button type="button" onClick={onBack} className="w-full bg-transparent text-gray-400 hover:text-black text-xs uppercase tracking-[0.1em] transition-colors">Atrás</button>
                    </div>
                </div>
            );
        };

        const MeasurementInput = ({ title, value, suffix, placeholder, isLastStep = false, onChange, onNext, onBack }) => {
            const inputRef = useRef(null);
            useEffect(() => { const timer = setTimeout(() => inputRef.current?.focus(), 100); return () => clearTimeout(timer); }, []);
            const handleKeyDown = (e) => { if (e.key === 'Enter' && value) onNext(); };
            return (
                <div className="flex flex-col h-full">
                    <div className="flex items-center gap-2 text-xs uppercase tracking-[0.2em] font-semibold text-gray-400 mb-6">
                        <span className="w-1.5 h-1.5 bg-black rounded-full"></span>
                        Datos Corporales
                    </div>
                    <h2 className="text-4xl md:text-[2.5rem] font-light leading-none tracking-tight mb-4 text-black">{title}</h2>
                    <div className="relative my-10 border-b border-gray-200 focus-within:border-black transition-colors duration-300">
                        <input ref={inputRef} type="number" value={value} onChange={(e) => onChange(e.target.value)} onKeyDown={handleKeyDown} placeholder={placeholder} className="w-full text-6xl md:text-7xl font-thin py-2 bg-transparent outline-none text-black placeholder-gray-200" />
                        <span className="absolute right-0 bottom-4 text-base text-gray-400 tracking-wider">{suffix}</span>
                    </div>
                    <div className="mt-auto flex flex-col gap-6">
                        <button type="button" onClick={onNext} disabled={!value} className="w-full bg-black text-white border border-black p-5 text-sm uppercase tracking-[0.15em] font-medium hover:bg-zinc-800 transition-colors disabled:bg-gray-100 disabled:border-gray-100 disabled:text-gray-300 disabled:cursor-not-allowed">
                            {isLastStep ? 'Analizar' : 'Siguiente'}
                        </button>
                        <button type="button" onClick={onBack} className="w-full bg-transparent text-gray-400 hover:text-black text-xs uppercase tracking-[0.1em] transition-colors">Atrás</button>
                    </div>
                </div>
            );
        };

        // Obtener sizes y colors dinámicamente de CONFIG
        const SIZES = CONFIG.options.sizes.length > 0 ? CONFIG.options.sizes : ['M', 'L', 'XL'];
        const COLORS = CONFIG.options.colors.length > 0 ? CONFIG.options.colors : ['Black', 'Gray', 'Green'];

        const Result = ({ userData, resultImage, recommendedSize, onReset }) => {
            const [selectedSize, setSelectedSize] = useState(recommendedSize || SIZES[1] || 'L');
            const [selectedColor, setSelectedColor] = useState(COLORS[0] || 'Black');
            const [isAdding, setIsAdding] = useState(false);

            const titles = userData.gender === 'male'
                ? ['Te queda impecable', 'Ajuste Perfecto', 'Gran Estilo']
                : ['Estás radiante', 'Te queda divino', 'Silueta Perfecta'];
            const randomTitle = titles[Math.floor(Math.random() * titles.length)];

            const handleAddToCart = async () => {
                try {
                    setIsAdding(true);
                    // Pasar size Y color
                    await addToCart(CONFIG.productId, selectedSize, selectedColor);
                    // Cerrar el modal
                    window.parent.document.getElementById('clostech-modal').style.display = 'none';
                    // Magento mostrará automáticamente su mensaje de éxito
                } catch (error) {
                    console.error('Error agregando al carrito:', error);
                    alert('Error al agregar al carrito. Por favor, intenta de nuevo.');
                } finally {
                    setIsAdding(false);
                }
            };

            const handleWhatsapp = () => {
                const text = `¡Mira cómo me queda esta prenda! Mi talla ideal es ${selectedSize} según Clostech AI.`;
                window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank');
            };

            const getLabel = (size) => {
                const sizeIndex = SIZES.indexOf(size);
                const recommendedIndex = SIZES.indexOf(recommendedSize);
                
                if (size === recommendedSize) return 'Ideal';
                if (sizeIndex < recommendedIndex) return 'Ajustado';
                return 'Suelto';
            };

            return (
                <div className="flex flex-col animate-fade-in h-full">
                    <div className="flex items-center gap-2 text-xs uppercase tracking-[0.2em] font-semibold text-black mb-6">
                        <span className="w-1.5 h-1.5 bg-green-500 rounded-full"></span>
                        Análisis Completo
                    </div>
                    <h2 className="text-4xl md:text-[2.5rem] font-light leading-none tracking-tight mb-4 text-black">{randomTitle}</h2>
                    <p className="text-sm text-gray-500 leading-relaxed mb-12">
                        Te recomiendo <strong className="text-black font-semibold">Talla {selectedSize}</strong>
                    </p>

                    <div className="w-full max-w-[320px] mx-auto mb-14 select-none">
                        <div className="relative">
                            <div className="absolute top-[10px] left-2 right-2 h-[1px] bg-gray-100 -z-10"></div>
                            <div className="flex justify-between items-start w-full px-1">
                                {SIZES.map((size) => {
                                    const isSelected = selectedSize === size;
                                    return (
                                        <button key={size} onClick={() => setSelectedSize(size)} className="group flex flex-col items-center gap-4 focus:outline-none cursor-pointer">
                                            <div className={`w-6 h-6 rounded-full border-2 transition-all duration-300 ease-out relative z-10
                                                ${isSelected ? 'bg-black border-black scale-110 shadow-lg ring-4 ring-black/5' : 'bg-white border-gray-200 group-hover:border-gray-300 group-hover:scale-105'}`}></div>
                                            <div className={`flex flex-col items-center transition-all duration-300 transform ${isSelected ? 'opacity-100 translate-y-0' : 'opacity-40 translate-y-1'}`}>
                                                <span className={`text-lg font-bold leading-none mb-1 ${isSelected ? 'text-black' : 'text-gray-400'}`}>{size}</span>
                                                <span className="text-[10px] uppercase tracking-[0.2em] font-semibold text-gray-500">{getLabel(size)}</span>
                                            </div>
                                        </button>
                                    );
                                })}
                            </div>
                        </div>
                    </div>

                    <div className="text-xs uppercase tracking-[0.2em] font-semibold text-gray-400 mb-4">Variantes</div>
                    <div className="flex gap-4 mb-auto flex-wrap">
                        {COLORS.map((color) => (
                            <button 
                                key={color} 
                                onClick={() => setSelectedColor(color)}
                                className={`px-4 py-2 border border-gray-200 rounded transition-all duration-300 hover:scale-105 hover:shadow-md text-xs uppercase tracking-wider ${selectedColor === color ? 'bg-black text-white border-black' : 'bg-white text-black hover:border-gray-400'}`}
                            >
                                {color}
                            </button>
                        ))}
                    </div>

                    <div className="mt-8">
                        <div className="grid grid-cols-[1fr_auto_auto] gap-3 mb-4">
                            <button 
                                onClick={handleAddToCart}
                                disabled={isAdding}
                                className="flex items-center justify-center gap-3 bg-black text-white p-5 text-sm uppercase tracking-widest font-medium hover:bg-zinc-800 transition-colors shadow-sm active:transform active:scale-[0.99] disabled:opacity-50 disabled:cursor-not-allowed"
                            >
                                <ShoppingBag size={18} />
                                <span>{isAdding ? 'Agregando...' : `Añadir ${selectedSize}`}</span>
                            </button>
                            <button onClick={handleWhatsapp} className="w-[60px] bg-white border border-gray-200 flex items-center justify-center hover:border-[#25d366] hover:text-[#25d366] transition-colors">
                                <MessageCircle size={20} />
                            </button>
                            <button className="w-[60px] bg-white border border-gray-200 flex items-center justify-center hover:border-black hover:text-black transition-colors">
                                <Download size={20} />
                            </button>
                        </div>
                        <button type="button" onClick={onReset} className="w-full text-center text-gray-400 hover:text-black text-xs uppercase tracking-[0.1em] transition-colors py-2">Probar otra prenda</button>
                    </div>
                </div>
            );
        };

        const ControlPanel = ({ step, loadingState, loadingMessage, loadingSubMessage, userData, productImage, resultImage, recommendedSize, errorMessage, onUpload, onReset, onUpdateUser, onNext, onBack, onAnalyze }) => {
            const renderStep = () => {
                switch (step) {
                    case Step.INSTRUCTIONS: return <Instructions onUpload={onUpload} productImage={productImage} />;
                    case Step.CONFIRMATION: return <Confirmation onContinue={onNext} onChangePhoto={onReset} />;
                    case Step.GENDER: return <GenderSelection selected={userData.gender} onSelect={(gender) => onUpdateUser({ gender })} onNext={onNext} onBack={onBack} />;
                    case Step.AGE: return <MeasurementInput title="Tu Edad" value={userData.age} suffix="años" placeholder="00" onChange={(val) => onUpdateUser({ age: val })} onNext={onNext} onBack={onBack} />;
                    case Step.WEIGHT: return <MeasurementInput title="Tu Peso" value={userData.weight} suffix="kg" placeholder="00" onChange={(val) => onUpdateUser({ weight: val })} onNext={onNext} onBack={onBack} />;
                    case Step.HEIGHT: return <MeasurementInput title="Tu Altura" value={userData.height} suffix="cm" placeholder="000" onChange={(val) => onUpdateUser({ height: val })} onNext={onAnalyze} onBack={onBack} isLastStep />;
                    case Step.RESULT: return <Result userData={userData} resultImage={resultImage} recommendedSize={recommendedSize} onReset={onReset} />;
                    case Step.ERROR: return <ErrorDisplay message={errorMessage} onRetry={onReset} />;
                    default: return null;
                }
            };

            return (
                <section className="relative flex-1 bg-white overflow-hidden">
                    <div className="h-full w-full overflow-y-auto no-scrollbar">
                        <div className="flex flex-col min-h-full p-5 md:p-14 justify-center">
                            <div className="absolute top-0 right-0 p-5 md:p-8 z-10">
                                <button onClick={onReset} className="text-gray-800 hover:rotate-90 transition-transform duration-300 p-2 bg-white/80 backdrop-blur-sm rounded-full">
                                    <X size={24} strokeWidth={1.5} />
                                </button>
                            </div>
                            {loadingState !== LoadingState.IDLE && (
                                <div className="absolute inset-0 z-20 bg-white flex items-center justify-center">
                                    <Loader message={loadingMessage} subMessage={loadingSubMessage} />
                                </div>
                            )}
                            {loadingState === LoadingState.IDLE && (
                                <div className="w-full max-w-md mx-auto animate-fade-in py-8 md:py-0 h-full flex flex-col md:block">
                                    {renderStep()}
                                </div>
                            )}
                        </div>
                    </div>
                </section>
            );
        };

        // =====================================================================
        // MAIN APP
        // =====================================================================
        const INITIAL_USER_DATA = { gender: '', age: '', weight: '', height: '' };
        const INITIAL_STATE = {
            step: Step.INSTRUCTIONS,
            loadingState: LoadingState.IDLE,
            loadingMessage: '',
            loadingSubMessage: '',
            userData: INITIAL_USER_DATA,
            previewImage: DEFAULT_IMAGES.default,
            userImageUrl: null,
            resultImage: null,
            recommendedSize: null,
            errorMessage: null,
            userFile: null,
        };

        const App = () => {
            const [state, setState] = useState(INITIAL_STATE);

            const updateState = (updates) => setState((prev) => ({ ...prev, ...updates }));
            const updateUserData = (updates) => setState((prev) => ({ ...prev, userData: { ...prev.userData, ...updates } }));

            // Subir foto - solo preview local, sube a API después
            const handleUpload = (file) => {
                const objectUrl = URL.createObjectURL(file);
                updateState({ 
                    previewImage: objectUrl, 
                    userFile: file,
                    step: Step.CONFIRMATION 
                });
            };

            const handleReset = () => setState(INITIAL_STATE);

            const handleNext = () => {
                switch (state.step) {
                    case Step.CONFIRMATION: updateState({ step: Step.GENDER }); break;
                    case Step.GENDER: updateState({ step: Step.AGE }); break;
                    case Step.AGE: updateState({ step: Step.WEIGHT }); break;
                    case Step.WEIGHT: updateState({ step: Step.HEIGHT }); break;
                    default: break;
                }
            };

            const handleBack = () => {
                switch (state.step) {
                    case Step.GENDER: updateState({ step: Step.CONFIRMATION }); break;
                    case Step.AGE: updateState({ step: Step.GENDER }); break;
                    case Step.WEIGHT: updateState({ step: Step.AGE }); break;
                    case Step.HEIGHT: updateState({ step: Step.WEIGHT }); break;
                    default: break;
                }
            };

            // Procesar con IA - llamadas reales a la API
            const handleAnalyze = async () => {

                updateState({ 
                    loadingState: LoadingState.IDLE, 
                    step: Step.RESULT, 
                    resultImage: CONFIG.productImage,
                    previewImage: CONFIG.productImage,
                    recommendedSize: SIZES[1] || 'L'
                });
                return;
                
                try {
                    // Paso 1: Subir imagen del usuario
                    updateState({ 
                        loadingState: LoadingState.UPLOADING, 
                        loadingMessage: 'Subiendo imagen...', 
                        loadingSubMessage: 'PROCESANDO ARCHIVO' 
                    });

                    const userImageUrl = await uploadUserPhoto(state.userFile);

                    // Paso 2: Procesar con IA
                    updateState({ 
                        loadingState: LoadingState.ANALYZING, 
                        loadingMessage: 'Analizando con IA...', 
                        loadingSubMessage: 'CALCULANDO TALLE IDEAL',
                        userImageUrl: userImageUrl
                    });

                    const result = await processWithAI(userImageUrl);

                    // Guardar uso en localStorage
                    saveUsageToLocalStorage(result.result_image_url);

                    // Mostrar resultado
                    updateState({ 
                        loadingState: LoadingState.IDLE, 
                        step: Step.RESULT, 
                        resultImage: result.result_image_url,
                        previewImage: result.result_image_url,
                        recommendedSize: result.recommended_size || SIZES[1] || 'L'
                    });

                } catch (error) {
                    console.error('Error en análisis:', error);
                    updateState({ 
                        loadingState: LoadingState.IDLE, 
                        step: Step.ERROR,
                        errorMessage: error.message || 'Ocurrió un error inesperado'
                    });
                }
            };

            const isInstructionStep = state.step === Step.INSTRUCTIONS;

            return (
                <main className="w-full h-full md:h-auto md:w-[90%] md:max-w-[1100px] bg-white md:shadow-2xl overflow-hidden flex flex-col md:grid md:grid-cols-[45%_55%] md:min-h-[650px]">
                    <div className={`${isInstructionStep ? 'hidden md:block' : 'block'} w-full h-[35dvh] md:h-auto`}>
                        <VisualPanel imageSrc={state.previewImage} loadingState={state.loadingState} />
                    </div>
                    <ControlPanel
                        step={state.step}
                        loadingState={state.loadingState}
                        loadingMessage={state.loadingMessage}
                        loadingSubMessage={state.loadingSubMessage}
                        userData={state.userData}
                        productImage={CONFIG.productImage}
                        resultImage={state.resultImage}
                        recommendedSize={state.recommendedSize}
                        errorMessage={state.errorMessage}
                        onUpload={handleUpload}
                        onReset={handleReset}
                        onUpdateUser={updateUserData}
                        onNext={handleNext}
                        onBack={handleBack}
                        onAnalyze={handleAnalyze}
                    />
                </main>
            );
        };

        const root = createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>

</html>
